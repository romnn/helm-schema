+// helmsweep patch (tools/helmsweep/third_party/PATCH.md): the compiled schema
+// is memoized by the SHA-256 of the schema bytes, so a process validating many
+// value sets against one schema compiles it once. Only a successful compile
+// that loaded no external resource is kept; everything else compiles per call
+// exactly as upstream does. A compiled schema is shared read-only: Validate
+// allocates its own validator state per call.
+type compiledSchema struct {
+	done      chan struct{}
+	validator *jsonschema.Schema
+}
+
+var (
+	compiledSchemasMu sync.Mutex
+	compiledSchemas   = map[[sha256.Size]byte]*compiledSchema{}
+	schemaCompiles    atomic.Int64
+	schemaMemoHits    atomic.Int64
+)
+
+// CompiledSchemaMemoStats reports how many compiles ran and how many calls
+// reused a memoized compile.
+func CompiledSchemaMemoStats() (compiles, memoHits int64) {
+	return schemaCompiles.Load(), schemaMemoHits.Load()
+}
+
+// DropCompiledSchema forgets the memoized compile of schemaJSON, if any.
+func DropCompiledSchema(schemaJSON []byte) {
+	compiledSchemasMu.Lock()
+	delete(compiledSchemas, sha256.Sum256(schemaJSON))
+	compiledSchemasMu.Unlock()
+}
+
+// compileMemoized returns the memoized compile of schemaJSON, compiling it
+// once when concurrent callers ask for the same bytes.
+func compileMemoized(schemaJSON []byte, schema any) (*jsonschema.Schema, error) {
+	sum := sha256.Sum256(schemaJSON)
+	compiledSchemasMu.Lock()
+	entry, found := compiledSchemas[sum]
+	if !found {
+		entry = &compiledSchema{done: make(chan struct{})}
+		compiledSchemas[sum] = entry
+	}
+	compiledSchemasMu.Unlock()
+
+	if found {
+		<-entry.done
+		if entry.validator != nil {
+			schemaMemoHits.Add(1)
+			return entry.validator, nil
+		}
+		validator, _, err := compileSchema(schema)
+		return validator, err
+	}
+
+	defer func() {
+		if entry.validator == nil {
+			compiledSchemasMu.Lock()
+			if compiledSchemas[sum] == entry {
+				delete(compiledSchemas, sum)
+			}
+			compiledSchemasMu.Unlock()
+		}
+		close(entry.done)
+	}()
+	validator, loadedExternal, err := compileSchema(schema)
+	if err != nil {
+		return nil, err
+	}
+	if !loadedExternal {
+		entry.validator = validator
+	}
+	return validator, nil
+}
+
