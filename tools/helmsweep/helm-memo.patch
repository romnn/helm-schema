+// helmsweep patch (tools/helmsweep/third_party/PATCH.md): the compiled schema
+// is memoized by the SHA-256 of the schema bytes, so a process validating many
+// value sets against a chart's baseline/candidate pair reuses those compiles.
+// Sweep retains warmed schemas until its chart completes.
+// Resident servers set a two-entry limit before accepting commands.
+// Only a successful compile that loaded no external resource is kept; everything
+// else compiles per call exactly as upstream does.
+// A compiled schema is shared read-only: Validate allocates its own validator state per call.
+type compiledSchema struct {
+	sum       [sha256.Size]byte
+	done      chan struct{}
+	validator *jsonschema.Schema
+}
+
+var (
+	compiledSchemasMu   sync.Mutex
+	compiledSchemas     []*compiledSchema
+	compiledSchemaLimit int
+	schemaCompiles      atomic.Int64
+	schemaMemoHits      atomic.Int64
+)
+
+// CompiledSchemaMemoStats reports how many compiles ran and how many calls
+// reused a memoized compile.
+func CompiledSchemaMemoStats() (compiles, memoHits int64) {
+	return schemaCompiles.Load(), schemaMemoHits.Load()
+}
+
+// SetCompiledSchemaMemoLimit bounds retained entries; zero retains them until dropped.
+// Configure this before starting commands, never during concurrent validation.
+func SetCompiledSchemaMemoLimit(limit int) {
+	compiledSchemasMu.Lock()
+	defer compiledSchemasMu.Unlock()
+	compiledSchemaLimit = limit
+	if limit > 0 && len(compiledSchemas) > limit {
+		clear(compiledSchemas[limit:])
+		compiledSchemas = compiledSchemas[:limit]
+	}
+}
+
+// DropCompiledSchema forgets the memoized compile of schemaJSON, if any.
+func DropCompiledSchema(schemaJSON []byte) {
+	sum := sha256.Sum256(schemaJSON)
+	compiledSchemasMu.Lock()
+	defer compiledSchemasMu.Unlock()
+	for index, entry := range compiledSchemas {
+		if entry.sum == sum {
+			copy(compiledSchemas[index:], compiledSchemas[index+1:])
+			compiledSchemas[len(compiledSchemas)-1] = nil
+			compiledSchemas = compiledSchemas[:len(compiledSchemas)-1]
+			return
+		}
+	}
+}
+
+// compileMemoized shares a pending compile while its entry remains retained.
+// Eviction drops only the cache's reference; running validators and waiting
+// callers retain their own immutable entry.
+// An evicted compile is never reinserted.
+func compileMemoized(schemaJSON []byte, schema any) (*jsonschema.Schema, error) {
+	sum := sha256.Sum256(schemaJSON)
+	compiledSchemasMu.Lock()
+	var entry *compiledSchema
+	for index, cached := range compiledSchemas {
+		if cached.sum == sum {
+			entry = cached
+			copy(compiledSchemas[1:index+1], compiledSchemas[:index])
+			compiledSchemas[0] = cached
+			break
+		}
+	}
+	found := entry != nil
+	if !found {
+		entry = &compiledSchema{sum: sum, done: make(chan struct{})}
+		retained := len(compiledSchemas)
+		if compiledSchemaLimit > 0 {
+			retained = min(retained, compiledSchemaLimit-1)
+		}
+		compiledSchemas = append([]*compiledSchema{entry}, compiledSchemas[:retained]...)
+	}
+	compiledSchemasMu.Unlock()
+
+	if found {
+		<-entry.done
+		if entry.validator != nil {
+			schemaMemoHits.Add(1)
+			return entry.validator, nil
+		}
+		validator, _, err := compileSchema(schema)
+		return validator, err
+	}
+
+	defer func() {
+		if entry.validator == nil {
+			compiledSchemasMu.Lock()
+			for index, cached := range compiledSchemas {
+				if cached == entry {
+					copy(compiledSchemas[index:], compiledSchemas[index+1:])
+					compiledSchemas[len(compiledSchemas)-1] = nil
+					compiledSchemas = compiledSchemas[:len(compiledSchemas)-1]
+					break
+				}
+			}
+			compiledSchemasMu.Unlock()
+		}
+		close(entry.done)
+	}()
+	validator, loadedExternal, err := compileSchema(schema)
+	if err != nil {
+		return nil, err
+	}
+	if !loadedExternal {
+		entry.validator = validator
+	}
+	return validator, nil
+}
