{
  "$defs": {
    "constrains/commonLabels:t": {
      "properties": {
        "commonLabels": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "commonLabels"
      ],
      "type": "object"
    },
    "constrains/commonLabels:t+fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+7more": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1nameOverride:t@2"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1commonLabels:t"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.annotations:t"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.annotations"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor+serviceMonitor.annotations"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.annotations+serviceMonitor.annotations=null"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.annotations:helm-marker-free"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.enabled:t"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.namespace:t"
        }
      ]
    },
    "constrains/commonLabels:t+fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+7more@2": {
      "anyOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t+nameOverride+nameOverride:t+serviceMonitor.enabled:t"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride+fullnameOverride:t+serviceMonitor.enabled:t"
        },
        {
          "$ref": "#/$defs/constrains~1commonLabels:t+fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+7more"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+1more"
        },
        {
          "$ref": "#/$defs/constrains~1commonLabels:t+fullnameOverride+fullnameOverride:t+nameOverride:t+serviceMonitor+6more"
        }
      ]
    },
    "constrains/commonLabels:t+fullnameOverride+fullnameOverride:t+nameOverride:t+serviceMonitor+6more": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1commonLabels:t"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.annotations:t"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.annotations"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor+serviceMonitor.annotations"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.annotations+serviceMonitor.annotations=null"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride:t"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.annotations:helm-marker-free"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.enabled:t"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.namespace:t"
        }
      ]
    },
    "constrains/fullnameOverride": {
      "not": {
        "$ref": "#/$defs/constrains~1fullnameOverride@2"
      }
    },
    "constrains/fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+1more": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1nameOverride:t@2"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.enabled:t"
        }
      ]
    },
    "constrains/fullnameOverride+fullnameOverride:t+serviceMonitor.enabled:t": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.enabled:t"
        }
      ]
    },
    "constrains/fullnameOverride:t": {
      "not": {
        "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
      }
    },
    "constrains/fullnameOverride:t+nameOverride+nameOverride:t+serviceMonitor.enabled:t": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride:t@2"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride"
        },
        {
          "$ref": "#/$defs/constrains~1serviceMonitor.enabled:t"
        }
      ]
    },
    "constrains/fullnameOverride:t@2": {
      "properties": {
        "fullnameOverride": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "fullnameOverride"
      ],
      "type": "object"
    },
    "constrains/fullnameOverride@2": {
      "properties": {
        "fullnameOverride": {
          "type": "string"
        }
      },
      "required": [
        "fullnameOverride"
      ],
      "type": "object"
    },
    "constrains/nameOverride": {
      "not": {
        "$ref": "#/$defs/constrains~1nameOverride@2"
      }
    },
    "constrains/nameOverride:t": {
      "not": {
        "$ref": "#/$defs/constrains~1nameOverride:t@2"
      }
    },
    "constrains/nameOverride:t@2": {
      "properties": {
        "nameOverride": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "nameOverride"
      ],
      "type": "object"
    },
    "constrains/nameOverride@2": {
      "properties": {
        "nameOverride": {
          "type": "string"
        }
      },
      "required": [
        "nameOverride"
      ],
      "type": "object"
    },
    "constrains/serviceMonitor+serviceMonitor.annotations": {
      "not": {
        "anyOf": [
          {
            "$ref": "#/$defs/constrains~1serviceMonitor.annotations@2"
          },
          {
            "properties": {
              "serviceMonitor": {
                "properties": {
                  "annotations": {
                    "type": "null"
                  }
                },
                "required": [
                  "annotations"
                ],
                "type": "object"
              }
            },
            "required": [
              "serviceMonitor"
            ],
            "type": "object"
          }
        ]
      }
    },
    "constrains/serviceMonitor.annotations": {
      "not": {
        "properties": {
          "serviceMonitor": {
            "properties": {
              "annotations": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "annotations"
            ],
            "type": "object"
          }
        },
        "required": [
          "serviceMonitor"
        ],
        "type": "object"
      }
    },
    "constrains/serviceMonitor.annotations+serviceMonitor.annotations=null": {
      "not": {
        "anyOf": [
          {
            "properties": {
              "serviceMonitor": {
                "properties": {
                  "annotations": {
                    "enum": [
                      null
                    ]
                  }
                },
                "required": [
                  "annotations"
                ],
                "type": "object"
              }
            },
            "required": [
              "serviceMonitor"
            ],
            "type": "object"
          },
          {
            "$ref": "#/$defs/constrains~1serviceMonitor.annotations@2"
          }
        ]
      }
    },
    "constrains/serviceMonitor.annotations:helm-marker-free": {
      "properties": {
        "serviceMonitor": {
          "properties": {
            "annotations": {
              "$ref": "#/$defs/helm-marker-free"
            }
          },
          "required": [
            "annotations"
          ],
          "type": "object"
        }
      },
      "required": [
        "serviceMonitor"
      ],
      "type": "object"
    },
    "constrains/serviceMonitor.annotations:t": {
      "properties": {
        "serviceMonitor": {
          "properties": {
            "annotations": {
              "$ref": "#/$defs/t"
            }
          },
          "required": [
            "annotations"
          ],
          "type": "object"
        }
      },
      "required": [
        "serviceMonitor"
      ],
      "type": "object"
    },
    "constrains/serviceMonitor.annotations@2": {
      "not": {
        "properties": {
          "serviceMonitor": {
            "properties": {
              "annotations": {}
            },
            "required": [
              "annotations"
            ],
            "type": "object"
          }
        },
        "required": [
          "serviceMonitor"
        ],
        "type": "object"
      }
    },
    "constrains/serviceMonitor.enabled:t": {
      "properties": {
        "serviceMonitor": {
          "properties": {
            "enabled": {
              "$ref": "#/$defs/t"
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        }
      },
      "required": [
        "serviceMonitor"
      ],
      "type": "object"
    },
    "constrains/serviceMonitor.namespace:t": {
      "properties": {
        "serviceMonitor": {
          "properties": {
            "namespace": {
              "$ref": "#/$defs/t"
            }
          },
          "required": [
            "namespace"
          ],
          "type": "object"
        }
      },
      "required": [
        "serviceMonitor"
      ],
      "type": "object"
    },
    "helm-marker-free": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/helm-marker-free"
          },
          "propertyNames": {
            "not": {
              "pattern": "<no value>"
            }
          },
          "type": "object"
        },
        {
          "type": [
            "null",
            "boolean",
            "number"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/helm-marker-free"
          },
          "type": "array"
        },
        {
          "not": {
            "pattern": "<no value>"
          },
          "type": "string"
        }
      ]
    },
    "t": {
      "anyOf": [
        {
          "minProperties": 1,
          "type": "object"
        },
        {
          "not": {
            "const": 0
          },
          "type": "number"
        },
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "minItems": 1,
          "type": "array"
        },
        {
          "const": true
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "$ref": "#/$defs/constrains~1commonLabels:t+fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+7more@2"
      },
      "then": false
    },
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "properties": {
                "serviceMonitor": {}
              },
              "required": [
                "serviceMonitor"
              ],
              "type": "object"
            }
          },
          {
            "properties": {
              "serviceMonitor": {
                "enum": [
                  null
                ]
              }
            },
            "required": [
              "serviceMonitor"
            ],
            "type": "object"
          }
        ]
      },
      "then": false
    }
  ],
  "properties": {
    "affinity": {
      "description": "[Affinity](https://kubernetes.io/docs/concepts/scheduling-eviction/assign-pod-node/#affinity-and-anti-affinity) configuration.\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#scheduling) for details."
    },
    "autoscaling": {
      "description": "Autoscaling configuration (see [values.yaml](values.yaml) for details)."
    },
    "commonLabels": {
      "description": "Labels to apply to all resources and selectors.\nteam_name: dev"
    },
    "config": {
      "description": "Application configuration.\nSee the [official documentation](https://dexidp.io/docs/)."
    },
    "configSecret": {},
    "deploymentAnnotations": {
      "description": "Annotations to be added to deployment."
    },
    "deploymentLabels": {
      "description": "Labels to be added to deployment."
    },
    "env": {
      "description": "Additional environment variables passed directly to containers.\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#environment-variables) for details."
    },
    "envFrom": {
      "description": "Additional environment variables mounted from [secrets](https://kubernetes.io/docs/concepts/configuration/secret/#using-secrets-as-environment-variables) or [config maps](https://kubernetes.io/docs/tasks/configure-pod-container/configure-pod-configmap/#configure-all-key-value-pairs-in-a-configmap-as-container-environment-variables).\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#environment-variables) for details."
    },
    "envVars": {
      "description": "Similar to env but with support for all possible configurations.\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#environment-variables) for details.\n- name: SOME_ENV_VAR\nvalue: value\n- name: SOME_ENV_VAR2\nvalueFrom:\nsecretKeyRef:\nname: secret-name\nkey: secret-key\n- name: SOME_ENV_VAR3\nvalueFrom:\nconfigMapKeyRef:\nname: config-map-name\nkey: config-map-key"
    },
    "fullnameOverride": {
      "description": "A name to substitute for the full names of resources."
    },
    "global": {},
    "grpc": {},
    "hostAliases": {
      "description": "A list of hosts and IPs that will be injected into the pod's hosts file if specified.\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#hostname-and-name-resolution)"
    },
    "httpRoute": {},
    "https": {},
    "image": {},
    "imagePullSecrets": {
      "description": "Reference to one or more secrets to be used when [pulling images](https://kubernetes.io/docs/tasks/configure-pod-container/pull-image-private-registry/#create-a-pod-that-uses-your-secret) (from private registries)."
    },
    "ingress": {},
    "nameOverride": {
      "description": "A name in place of the chart name for `app:` labels."
    },
    "namespaceOverride": {
      "description": "A namespace in place of the release namespace for all resources."
    },
    "networkPolicy": {},
    "nodeSelector": {
      "description": "[Node selector](https://kubernetes.io/docs/concepts/scheduling-eviction/assign-pod-node/#nodeselector) configuration."
    },
    "podAnnotations": {
      "description": "Annotations to be added to pods."
    },
    "podDisruptionBudget": {},
    "podLabels": {
      "description": "Labels to be added to pods."
    },
    "podSecurityContext": {
      "description": "Pod [security context](https://kubernetes.io/docs/tasks/configure-pod-container/security-context/#set-the-security-context-for-a-pod).\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#security-context) for details.\nfsGroup: 2000"
    },
    "priorityClassName": {
      "description": "Specify a priority class name to set [pod priority](https://kubernetes.io/docs/concepts/scheduling-eviction/pod-priority-preemption/#pod-priority)."
    },
    "rbac": {},
    "replicaCount": {
      "description": "Number of replicas (pods) to launch."
    },
    "resources": {
      "description": "Container resource [requests and limits](https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/).\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#resources) for details.\nWe usually recommend not to specify default resources and to leave this as a conscious\nchoice for the user. This also increases chances charts run on environments with little\nresources, such as Minikube. If you do want to specify resources, uncomment the following\nlines, adjust them as necessary, and remove the curly braces after 'resources:'.\nlimits:\ncpu: 100m\nmemory: 128Mi\nrequests:\ncpu: 100m\nmemory: 128Mi"
    },
    "revisionHistoryLimit": {
      "description": "Define the [count of deployment revisions](https://kubernetes.io/docs/concepts/workloads/controllers/deployment/#clean-up-policy) to be kept.\nMay be set to 0 in case of GitOps deployment approach."
    },
    "securityContext": {
      "description": "Container [security context](https://kubernetes.io/docs/tasks/configure-pod-container/security-context/#set-the-security-context-for-a-container).\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#security-context-1) for details.\ncapabilities:\ndrop:\n- ALL\nreadOnlyRootFilesystem: true\nrunAsNonRoot: true\nrunAsUser: 1000"
    },
    "service": {},
    "serviceAccount": {},
    "serviceMonitor": {
      "additionalProperties": {},
      "description": "filters:\n- type: RequestHeaderModifier\nrequestHeaderModifier:\nadd:\n- name: X-Custom-Header\nvalue: custom-value",
      "properties": {
        "annotations": {
          "description": "Annotations to be added to the ServiceMonitor.\nref: https://github.com/coreos/prometheus-operator/blob/master/Documentation/api.md#prometheusspec"
        },
        "bearerTokenFile": {
          "description": "Prometheus scrape bearerTokenFile"
        },
        "enabled": {
          "description": "Enable Prometheus ServiceMonitor.\nSee the [documentation](https://github.com/prometheus-operator/prometheus-operator/blob/main/Documentation/design.md#servicemonitor) and the [API reference](https://github.com/prometheus-operator/prometheus-operator/blob/main/Documentation/api.md#servicemonitor) for details."
        },
        "honorLabels": {
          "description": "HonorLabels chooses the metric's labels on collisions with target labels."
        },
        "interval": {
          "description": "(duration) Prometheus scrape interval."
        },
        "labels": {
          "description": "Labels to be added to the ServiceMonitor.\nref: https://github.com/coreos/prometheus-operator/blob/master/Documentation/api.md#prometheusspec"
        },
        "metricRelabelings": {
          "description": "Prometheus scrape metric relabel configs\nto apply to samples before ingestion.\n[Metric Relabeling](https://prometheus.io/docs/prometheus/latest/configuration/configuration/#metric_relabel_configs)\n- action: keep\nregex: 'kube_(daemonset|deployment|pod|namespace|node|statefulset).+'\nsourceLabels: [__name__]"
        },
        "namespace": {
          "description": "Namespace where the ServiceMonitor resource should be deployed."
        },
        "path": {
          "description": "HTTP path to scrape for metrics."
        },
        "scheme": {
          "description": "HTTP scheme to use for scraping.\nCan be used with `tlsConfig` for example if using istio mTLS."
        },
        "scrapeTimeout": {
          "description": "(duration) Prometheus scrape timeout."
        },
        "tlsConfig": {
          "description": "TLS configuration to use when scraping the endpoint.\nFor example if using istio mTLS.\nOf type: https://github.com/coreos/prometheus-operator/blob/master/Documentation/api.md#tlsconfig"
        }
      },
      "type": "object"
    },
    "strategy": {
      "description": "Deployment [strategy](https://kubernetes.io/docs/concepts/workloads/controllers/deployment/#strategy) configuration.\nrollingUpdate:\nmaxUnavailable: 1\ntype: RollingUpdate"
    },
    "tolerations": {
      "description": "[Tolerations](https://kubernetes.io/docs/concepts/scheduling-eviction/taint-and-toleration/) for node taints.\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#scheduling) for details."
    },
    "topologySpreadConstraints": {
      "description": "[TopologySpreadConstraints](https://kubernetes.io/docs/concepts/workloads/pods/pod-topology-spread-constraints/) configuration.\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#scheduling) for details."
    },
    "volumeMounts": {
      "description": "Additional [volume mounts](https://kubernetes.io/docs/tasks/configure-pod-container/configure-volume-storage/).\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#volumes-1) for details."
    },
    "volumes": {
      "description": "Additional storage [volumes](https://kubernetes.io/docs/concepts/storage/volumes/).\nSee the [API reference](https://kubernetes.io/docs/reference/kubernetes-api/workload-resources/pod-v1/#volumes-1) for details."
    }
  },
  "type": "object"
}
