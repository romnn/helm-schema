{
  "$defs": {
    "constrains/fullnameOverride": {
      "not": {
        "$ref": "#/$defs/constrains~1fullnameOverride@2"
      }
    },
    "constrains/fullnameOverride+fullnameOverride:t": {
      "anyOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t"
        }
      ]
    },
    "constrains/fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+test.enabled:t": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1nameOverride"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride:t@3"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1test.enabled:t"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@3"
        }
      ]
    },
    "constrains/fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+test.enabled:t@2": {
      "anyOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t+nameOverride+nameOverride:t+test.enabled:t"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+test.enabled:t"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride+fullnameOverride:t+test.enabled:t"
        }
      ]
    },
    "constrains/fullnameOverride+fullnameOverride:t+test.enabled:t": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride"
        },
        {
          "$ref": "#/$defs/constrains~1test.enabled:t"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@3"
        }
      ]
    },
    "constrains/fullnameOverride+fullnameOverride:t@2": {
      "anyOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
        }
      ]
    },
    "constrains/fullnameOverride:t": {
      "not": {
        "$ref": "#/$defs/constrains~1fullnameOverride:t@3"
      }
    },
    "constrains/fullnameOverride:t+nameOverride+nameOverride:t": {
      "anyOf": [
        {
          "$ref": "#/$defs/constrains~1nameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride:t"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@3"
        }
      ]
    },
    "constrains/fullnameOverride:t+nameOverride+nameOverride:t+test.enabled:t": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1nameOverride"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride:t@3"
        },
        {
          "$ref": "#/$defs/constrains~1test.enabled:t"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
        }
      ]
    },
    "constrains/fullnameOverride:t+nameOverride+nameOverride:t@2": {
      "anyOf": [
        {
          "$ref": "#/$defs/constrains~1nameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride:t@2"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@3"
        }
      ]
    },
    "constrains/fullnameOverride:t@2": {
      "not": {
        "$ref": "#/$defs/constrains~1fullnameOverride:t@3"
      }
    },
    "constrains/fullnameOverride:t@3": {
      "properties": {
        "fullnameOverride": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "fullnameOverride"
      ],
      "type": "object"
    },
    "constrains/fullnameOverride@2": {
      "properties": {
        "fullnameOverride": {
          "type": "string"
        }
      },
      "required": [
        "fullnameOverride"
      ],
      "type": "object"
    },
    "constrains/nameOverride": {
      "not": {
        "$ref": "#/$defs/constrains~1nameOverride@2"
      }
    },
    "constrains/nameOverride+nameOverride:t": {
      "anyOf": [
        {
          "$ref": "#/$defs/constrains~1nameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride:t"
        }
      ]
    },
    "constrains/nameOverride+nameOverride:t@2": {
      "anyOf": [
        {
          "$ref": "#/$defs/constrains~1nameOverride@2"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride:t@2"
        }
      ]
    },
    "constrains/nameOverride:t": {
      "not": {
        "$ref": "#/$defs/constrains~1nameOverride:t@3"
      }
    },
    "constrains/nameOverride:t@2": {
      "not": {
        "$ref": "#/$defs/constrains~1nameOverride:t@3"
      }
    },
    "constrains/nameOverride:t@3": {
      "properties": {
        "nameOverride": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "nameOverride"
      ],
      "type": "object"
    },
    "constrains/nameOverride@2": {
      "properties": {
        "nameOverride": {
          "type": "string"
        }
      },
      "required": [
        "nameOverride"
      ],
      "type": "object"
    },
    "constrains/test.enabled:t": {
      "properties": {
        "test": {
          "properties": {
            "enabled": {
              "$ref": "#/$defs/t"
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        }
      },
      "required": [
        "test"
      ],
      "type": "object"
    },
    "t": {
      "anyOf": [
        {
          "minProperties": 1,
          "type": "object"
        },
        {
          "not": {
            "const": 0
          },
          "type": "number"
        },
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "minItems": 1,
          "type": "array"
        },
        {
          "const": true
        }
      ]
    },
    "values/test.podSecurityContext.fsGroup": {
      "description": "UID of seluser in selenium/standalone-chromium",
      "type": "integer"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "allOf": [
          {
            "$ref": "#/$defs/constrains~1test.enabled:t"
          },
          {
            "$ref": "#/$defs/constrains~1nameOverride+nameOverride:t@2"
          },
          {
            "$ref": "#/$defs/constrains~1fullnameOverride+fullnameOverride:t@2"
          },
          {
            "$ref": "#/$defs/constrains~1fullnameOverride:t+nameOverride+nameOverride:t@2"
          },
          {
            "anyOf": [
              {
                "properties": {
                  "image": {
                    "enum": [
                      null
                    ]
                  }
                },
                "required": [
                  "image"
                ],
                "type": "object"
              },
              {
                "not": {
                  "properties": {
                    "image": {}
                  },
                  "required": [
                    "image"
                  ],
                  "type": "object"
                }
              }
            ]
          }
        ]
      },
      "then": false
    },
    {
      "if": {
        "$ref": "#/$defs/constrains~1fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+test.enabled:t@2"
      },
      "then": false
    },
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "properties": {
                "test": {}
              },
              "required": [
                "test"
              ],
              "type": "object"
            }
          },
          {
            "properties": {
              "test": {
                "enum": [
                  null
                ]
              }
            },
            "required": [
              "test"
            ],
            "type": "object"
          }
        ]
      },
      "then": false
    },
    {
      "if": {
        "allOf": [
          {
            "$ref": "#/$defs/constrains~1test.enabled:t"
          },
          {
            "$ref": "#/$defs/constrains~1fullnameOverride+fullnameOverride:t"
          },
          {
            "$ref": "#/$defs/constrains~1fullnameOverride:t+nameOverride+nameOverride:t"
          },
          {
            "$ref": "#/$defs/constrains~1nameOverride+nameOverride:t"
          }
        ]
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "image": {
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "affinity": {
      "description": "Pod affinity"
    },
    "args": {
      "description": "Overrides the default args for the Keycloak container"
    },
    "autoscaling": {},
    "cache": {},
    "clusterDomain": {
      "description": "The internal Kubernetes cluster domain"
    },
    "command": {
      "description": "Overrides the default entrypoint of the Keycloak container"
    },
    "commonLabels": {
      "description": "Additional labels applied to every resource in this chart, and on the StatefulSet's pods"
    },
    "database": {},
    "dbchecker": {},
    "enableServiceLinks": {
      "description": "Indicates whether information about services should be injected into Pod's environment variables, matching the syntax of Docker links"
    },
    "extraContainers": {
      "description": "Additional sidecar containers, e. g. for a database proxy, such as Google's cloudsql-proxy"
    },
    "extraEnv": {
      "description": "Additional environment variables for Keycloak\n- name: KC_LOG_LEVEL\nvalue: DEBUG"
    },
    "extraEnvFrom": {
      "description": "Additional environment variables for Keycloak mapped from Secret or ConfigMap"
    },
    "extraInitContainers": {
      "description": "Additional init containers, e. g. for providing custom themes"
    },
    "extraManifests": {
      "description": "Extra Kubernetes objects to deploy with the helm chart\n- |\napiVersion: v1\nkind: ConfigMap\nmetadata:\nname: {{ include \"keycloak.fullname\" . }}-tpl\ndata:\nfoo: bar\n-   apiVersion: v1\nkind: ConfigMap\nmetadata:\nname: \"{{ include \\\"keycloak.fullname\\\" . }}-tpl\"\ndata:\nfoo: bar"
    },
    "extraPorts": {
      "description": "Add additional ports, e. g. for admin console or exposing JGroups ports"
    },
    "extraServiceMonitor": {},
    "extraVolumeMounts": {
      "description": "Add additional volumes mounts, e. g. for custom themes"
    },
    "extraVolumes": {
      "description": "Add additional volumes, e. g. for custom themes"
    },
    "fullnameOverride": {
      "description": "Optionally override the fully qualified name"
    },
    "global": {},
    "health": {},
    "hostAliases": {
      "description": "Mapping between IPs and hostnames that will be injected as entries in the Pod's hosts files\n- ip: \"1.2.3.4\"\nhostnames:\n- \"my.host.com\""
    },
    "http": {},
    "httpRoute": {
      "description": "Expose the service via gateway-api HTTPRoute\nRequires Gateway API resources and suitable controller installed within the cluster\n(see: https://gateway-api.sigs.k8s.io/guides/)"
    },
    "image": {
      "additionalProperties": {},
      "properties": {
        "tag": {
          "description": "Overrides the Keycloak image tag whose default is the chart appVersion"
        }
      }
    },
    "imagePullSecrets": {
      "description": "Image pull secrets for the Pod\n- name: myRegistrKeySecretName"
    },
    "ingress": {},
    "lifecycleHooks": {
      "description": "Lifecycle hooks for the Keycloak container\npostStart:\nexec:\ncommand:\n- /bin/sh\n- -c\n- ls"
    },
    "livenessProbe": {
      "description": "Liveness probe configuration"
    },
    "metrics": {},
    "nameOverride": {
      "description": "Optionally override the name"
    },
    "namespaceOverride": {
      "description": "Optionally override the namespace for all resources. Useful for umbrella charts that\ndeploy multiple aliased keycloak instances each into their own namespace."
    },
    "networkPolicy": {
      "description": "Network policy configuration\nhttps://kubernetes.io/docs/concepts/services-networking/network-policies/"
    },
    "nodeSelector": {
      "description": "Node labels for Pod assignment"
    },
    "podAnnotations": {
      "description": "Additional Pod annotations"
    },
    "podDisruptionBudget": {
      "description": "Pod disruption budget\nmaxUnavailable: 1\nminAvailable: 1"
    },
    "podLabels": {
      "description": "Additional Pod labels"
    },
    "podManagementPolicy": {
      "description": "Pod management policy. One of `Parallel` or `OrderedReady`"
    },
    "podSecurityContext": {
      "description": "SecurityContext for the entire Pod. Every container running in the Pod will inherit this SecurityContext. This might be relevant when other components of the environment inject additional containers into running Pods (service meshes are the most prominent example for this)"
    },
    "priorityClassName": {
      "description": "Pod priority class name"
    },
    "prometheusRule": {},
    "proxy": {},
    "rbac": {},
    "readinessProbe": {
      "description": "Readiness probe configuration"
    },
    "replicas": {
      "description": "The number of replicas to create (has no effect if autoscaling enabled)"
    },
    "resources": {
      "description": "Pod resource requests and limits\nrequests:\ncpu: \"500m\"\nmemory: \"1024Mi\"\nlimits:\ncpu: \"500m\"\nmemory: \"1024Mi\""
    },
    "restartPolicy": {
      "description": "Pod restart policy. One of `Always`, `OnFailure`, or `Never`"
    },
    "revisionHistoryLimit": {
      "description": "StatefulSet's revision history limit (number of old ReplicaSets to retain). Defaults to 10 if not set"
    },
    "route": {},
    "secrets": {
      "description": "Configuration for secrets that should be created\nmysecret:\ntype: {}\nannotations: {}\nlabels: {}\nstringData: {}\ndata: {}"
    },
    "securityContext": {
      "description": "SecurityContext for the Keycloak container"
    },
    "service": {},
    "serviceAccount": {},
    "serviceHeadless": {},
    "serviceMonitor": {},
    "skipInitContainers": {
      "description": "When using service meshes which rely on a sidecar, it may be necessary to skip init containers altogether,\nsince the sidecar doesn't start until the init containers are done, and the sidecar may be required\nfor network access.\nFor example, Istio in strict mTLS mode prevents the dbchecker init container from ever completing"
    },
    "startupProbe": {
      "description": "Startup probe configuration"
    },
    "statefulsetAnnotations": {
      "description": "Annotations for the StatefulSet"
    },
    "statefulsetLabels": {
      "description": "Additional labels for the StatefulSet"
    },
    "terminationGracePeriodSeconds": {
      "description": "Termination grace period in seconds for Keycloak shutdown. Clusters with a large cache might need to extend this to give Infinispan more time to rebalance"
    },
    "test": {
      "additionalProperties": {},
      "properties": {
        "deletionPolicy": {
          "description": "See https://helm.sh/docs/topics/charts_hooks/#hook-deletion-policies",
          "type": "string"
        },
        "enabled": {
          "description": "If `true`, test resources are created"
        },
        "image": {
          "additionalProperties": {},
          "properties": {
            "pullPolicy": {
              "description": "The image pull policy for the test Pod image",
              "type": "string"
            },
            "repository": {
              "description": "The image for the test Pod",
              "type": "string"
            },
            "tag": {
              "description": "The tag for the test Pod image",
              "type": "string"
            }
          },
          "type": "object"
        },
        "podSecurityContext": {
          "additionalProperties": {},
          "description": "SecurityContext for the entire test Pod",
          "properties": {
            "fsGroup": {
              "$ref": "#/$defs/values~1test.podSecurityContext.fsGroup"
            }
          },
          "type": "object"
        },
        "securityContext": {
          "additionalProperties": {},
          "description": "SecurityContext for the test container",
          "properties": {
            "runAsNonRoot": {
              "type": "boolean"
            },
            "runAsUser": {
              "$ref": "#/$defs/values~1test.podSecurityContext.fsGroup"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "tolerations": {
      "description": "Node taints to tolerate"
    },
    "topologySpreadConstraints": {
      "description": "Topology spread constraints template"
    },
    "updateStrategy": {
      "description": "StatefulSet's update strategy"
    },
    "volumeClaimTemplates": {
      "description": "Add volume claim templates to the StatefulSet, e. g. for dynamic provisioning\n- metadata:\nname: themes\nspec:\naccessModes: [ \"ReadWriteOncePod\" ]\nstorageClassName: \"my-storage-class\"\nresources:\nrequests:\nstorage: 1Gi"
    }
  },
  "type": "object"
}
