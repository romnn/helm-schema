{
  "$defs": {
    "constrains/enabled": {
      "properties": {
        "enabled": {}
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "constrains/enabled+enabled=null": {
      "anyOf": [
        {
          "not": {
            "$ref": "#/$defs/constrains~1enabled"
          }
        },
        {
          "properties": {
            "enabled": {
              "enum": [
                null
              ]
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        }
      ]
    },
    "constrains/enabled:t": {
      "properties": {
        "enabled": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "constrains/redis-ha+redis-ha.enabled+redis-ha.enabled:t+redis-ha.enabled=null": {
      "anyOf": [
        {
          "properties": {
            "redis-ha": {
              "allOf": [
                {
                  "$ref": "#/$defs/constrains~1enabled+enabled=null"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "required": [
            "redis-ha"
          ],
          "type": "object"
        },
        {
          "not": {
            "properties": {
              "redis-ha": {
                "type": "object"
              }
            },
            "required": [
              "redis-ha"
            ],
            "type": "object"
          }
        },
        {
          "properties": {
            "redis-ha": {
              "$ref": "#/$defs/constrains~1enabled:t"
            }
          },
          "required": [
            "redis-ha"
          ],
          "type": "object"
        }
      ]
    },
    "constrains/redis-ha.enabled": {
      "not": {
        "properties": {
          "redis-ha": {
            "$ref": "#/$defs/constrains~1enabled"
          }
        },
        "required": [
          "redis-ha"
        ],
        "type": "object"
      }
    },
    "constrains/sentinel.auth:t": {
      "properties": {
        "sentinel": {
          "properties": {
            "auth": {
              "$ref": "#/$defs/t"
            }
          },
          "required": [
            "auth"
          ],
          "type": "object"
        }
      },
      "required": [
        "sentinel"
      ],
      "type": "object"
    },
    "constrains/sentinel.existingSecret": {
      "not": {
        "properties": {
          "sentinel": {
            "properties": {
              "existingSecret": {
                "type": "string"
              }
            },
            "required": [
              "existingSecret"
            ],
            "type": "object"
          }
        },
        "required": [
          "sentinel"
        ],
        "type": "object"
      }
    },
    "constrains/sentinel.existingSecret:t": {
      "properties": {
        "sentinel": {
          "properties": {
            "existingSecret": {
              "$ref": "#/$defs/t"
            }
          },
          "required": [
            "existingSecret"
          ],
          "type": "object"
        }
      },
      "required": [
        "sentinel"
      ],
      "type": "object"
    },
    "t": {
      "anyOf": [
        {
          "minProperties": 1,
          "type": "object"
        },
        {
          "not": {
            "const": 0
          },
          "type": "number"
        },
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "minItems": 1,
          "type": "array"
        },
        {
          "const": true
        }
      ]
    },
    "when/sentinel.auth!=null+sentinel.existingSecret!=null/then/fail": {
      "if": {
        "allOf": [
          {
            "properties": {
              "sentinel": {
                "properties": {
                  "existingSecret": {
                    "not": {
                      "enum": [
                        null
                      ]
                    }
                  }
                },
                "required": [
                  "existingSecret"
                ],
                "type": "object"
              }
            },
            "required": [
              "sentinel"
            ],
            "type": "object"
          },
          {
            "properties": {
              "sentinel": {
                "properties": {
                  "auth": {
                    "not": {
                      "enum": [
                        null
                      ]
                    }
                  }
                },
                "required": [
                  "auth"
                ],
                "type": "object"
              }
            },
            "required": [
              "sentinel"
            ],
            "type": "object"
          }
        ]
      },
      "then": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "allOf": [
              {
                "anyOf": [
                  {
                    "properties": {
                      "redis-ha": {
                        "properties": {
                          "enabled": {
                            "not": {
                              "enum": [
                                true
                              ]
                            }
                          }
                        },
                        "required": [
                          "enabled"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "redis-ha"
                    ],
                    "type": "object"
                  },
                  {
                    "$ref": "#/$defs/constrains~1redis-ha.enabled"
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "properties": {
                      "redis-ha": {
                        "properties": {
                          "enabled": {
                            "not": {
                              "enum": [
                                false
                              ]
                            }
                          }
                        },
                        "required": [
                          "enabled"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "redis-ha"
                    ],
                    "type": "object"
                  },
                  {
                    "$ref": "#/$defs/constrains~1redis-ha.enabled"
                  }
                ]
              }
            ]
          },
          {
            "properties": {
              "redis-ha": {
                "properties": {
                  "enabled": {
                    "enum": [
                      true
                    ]
                  }
                },
                "required": [
                  "enabled"
                ],
                "type": "object"
              }
            },
            "required": [
              "redis-ha"
            ],
            "type": "object"
          }
        ]
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "redis-ha": {
            "description": "Enables and configure the automatic deployment of the redis-ha subchart",
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "metrics": {
                "enum": [
                  null
                ]
              }
            },
            "required": [
              "metrics"
            ],
            "type": "object"
          },
          {
            "not": {
              "properties": {
                "metrics": {}
              },
              "required": [
                "metrics"
              ],
              "type": "object"
            }
          }
        ]
      },
      "then": false
    },
    {
      "if": {
        "properties": {
          "metrics": {
            "$ref": "#/$defs/constrains~1enabled:t"
          }
        },
        "required": [
          "metrics"
        ],
        "type": "object"
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "metrics": {
            "additionalProperties": {},
            "properties": {
              "serviceMonitor": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "additionalProperties": {},
      "properties": {
        "redis-ha": {
          "description": "Enables and configure the automatic deployment of the redis-ha subchart",
          "type": [
            "null",
            "object"
          ]
        }
      }
    },
    {
      "if": {
        "$ref": "#/$defs/constrains~1redis-ha+redis-ha.enabled+redis-ha.enabled:t+redis-ha.enabled=null"
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "redis-ha": {
            "additionalProperties": {},
            "description": "Enables and configure the automatic deployment of the redis-ha subchart",
            "properties": {
              "sentinel": {
                "description": "Sentinel specific configuration options",
                "type": "object"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "alphaConfig": {},
    "authenticatedEmailsFile": {
      "description": "To authorize individual email addresses\nThat is part of extraArgs but since this needs special treatment we need to do a separate section"
    },
    "autoscaling": {
      "description": "Horizontal Pod Autoscaling\nref: https://kubernetes.io/docs/tasks/run-application/horizontal-pod-autoscale/"
    },
    "checkDeprecation": {
      "description": "Enables apiVersion deprecation checks"
    },
    "config": {
      "description": "Oauth client configuration specifics"
    },
    "customLabels": {
      "description": "Custom labels to add into metadata"
    },
    "deploymentAnnotations": {},
    "deploymentLabels": {},
    "enableServiceLinks": {},
    "envFrom": {
      "description": "Load environment variables from a ConfigMap(s) and/or Secret(s)\nthat already exists (created and managed by you).\nref: https://kubernetes.io/docs/tasks/configure-pod-container/configure-pod-configmap/#configure-all-key-value-pairs-in-a-configmap-as-container-environment-variables\nPS: Changes in these ConfigMaps or Secrets will not be automatically\ndetected and you must manually restart the relevant Pods after changes.\n- configMapRef:\nname: special-config\n- secretRef:\nname: special-config-secret"
    },
    "extraArgs": {},
    "extraContainers": {
      "description": "Additional containers to be added to the pod.\n- name: my-sidecar\nimage: nginx:latest"
    },
    "extraEnv": {
      "description": "Example: Load secrets from an external secret (e.g., Azure Key\nVault via CSI Driver)\nextraEnv:\n- name: OAUTH2_PROXY_CLIENT_ID\nvalueFrom:\nsecretKeyRef:\nname: azure-keyvault-secret\nkey: client-id\n- name: OAUTH2_PROXY_CLIENT_SECRET\nvalueFrom:\nsecretKeyRef:\nname: azure-keyvault-secret\nkey: client-secret\n- name: OAUTH2_PROXY_COOKIE_SECRET\nvalueFrom:\nsecretKeyRef:\nname: azure-keyvault-secret\nkey: cookie-secret"
    },
    "extraInitContainers": {
      "description": "Additional Init containers to be added to the pod.\n- name: wait-for-idp\nimage: my-idp-wait:latest\ncommand:\n- sh\n- -c\n- wait-for-idp.sh"
    },
    "extraObjects": {
      "description": "Extra K8s manifests to deploy\n- apiVersion: secrets-store.csi.x-k8s.io/v1\nkind: SecretProviderClass\nmetadata:\nname: oauth2-proxy-secrets-store\nspec:\nprovider: aws\nparameters:\nobjects: |\n- objectName: \"oauth2-proxy\"\nobjectType: \"secretsmanager\"\njmesPath:\n- path: \"client_id\"\nobjectAlias: \"client-id\"\n- path: \"client_secret\"\nobjectAlias: \"client-secret\"\n- path: \"cookie_secret\"\nobjectAlias: \"cookie-secret\"\nsecretObjects:\n- data:\n- key: client-id\nobjectName: client-id\n- key: client-secret\nobjectName: client-secret\n- key: cookie-secret\nobjectName: cookie-secret\nsecretName: oauth2-proxy-secrets-store\ntype: Opaque"
    },
    "extraVolumeMounts": {
      "description": "- mountPath: /etc/ssl/certs/\nname: ca-bundle-cert"
    },
    "extraVolumes": {
      "description": "- name: ca-bundle-cert\nsecret:\nsecretName: <secret-name>"
    },
    "gatewayApi": {
      "description": "Gateway API HTTPRoute configuration\nRef: https://gateway-api.sigs.k8s.io/api-types/httproute/"
    },
    "global": {},
    "hostAliases": {
      "description": "hostAliases is a list of aliases to be added to /etc/hosts for network name resolution\n- ip: \"10.xxx.xxx.xxx\"\nhostnames:\n- \"auth.example.com\"\n- ip: 127.0.0.1\nhostnames:\n- chart-example.local\n- example.local"
    },
    "htpasswdFile": {
      "description": "Additionally authenticate against a htpasswd file. Entries must be created with \"htpasswd -B\" for bcrypt encryption.\nAlternatively supply an existing secret which contains the required information."
    },
    "httpScheme": {
      "description": "whether to use http or https"
    },
    "image": {},
    "imagePullSecrets": {
      "description": "Optionally specify an array of imagePullSecrets.\nSecrets must be manually created in the namespace.\nref: https://kubernetes.io/docs/concepts/containers/images/#specifying-imagepullsecrets-on-a-pod\n- name: myRegistryKeySecretName"
    },
    "ingress": {},
    "initContainers": {},
    "kubeVersion": {
      "description": "Force the target Kubernetes version (it uses Helm `.Capabilities` if not set).\nThis is especially useful for `helm template` as capabilities are always empty\ndue to the fact that it doesn't query an actual cluster"
    },
    "livenessProbe": {
      "description": "Configure Kubernetes liveness and readiness probes.\nRef: https://kubernetes.io/docs/tasks/configure-pod-container/configure-liveness-readiness-probes/\nDisable both when deploying with Istio 1.0 mTLS. https://istio.io/help/faq/security/#k8s-health-checks"
    },
    "metrics": {
      "additionalProperties": {},
      "allOf": [
        {
          "if": {
            "allOf": [
              {
                "$ref": "#/$defs/constrains~1enabled:t"
              },
              {
                "anyOf": [
                  {
                    "not": {
                      "properties": {
                        "serviceMonitor": {}
                      },
                      "required": [
                        "serviceMonitor"
                      ],
                      "type": "object"
                    }
                  },
                  {
                    "properties": {
                      "serviceMonitor": {
                        "enum": [
                          null
                        ]
                      }
                    },
                    "required": [
                      "serviceMonitor"
                    ],
                    "type": "object"
                  }
                ]
              }
            ]
          },
          "then": false
        }
      ],
      "properties": {
        "enabled": {
          "description": "Enable Prometheus metrics endpoint"
        },
        "port": {
          "description": "Serve Prometheus metrics on this port",
          "type": "integer"
        },
        "service": {
          "additionalProperties": {},
          "description": "when service.type is NodePort ...\nnodePort: 44180\nProtocol set on the service for the metrics port",
          "properties": {
            "appProtocol": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "serviceMonitor": {
          "additionalProperties": {},
          "properties": {
            "annotations": {
              "description": "Used to pass annotations that are used by the Prometheus installed in your cluster to select Service Monitors to work with\nref: https://github.com/coreos/prometheus-operator/blob/master/Documentation/api.md#prometheusspec"
            },
            "enabled": {
              "description": "Enable Prometheus Operator ServiceMonitor"
            }
          }
        }
      },
      "type": "object"
    },
    "namespaceOverride": {
      "description": "Override the deployment namespace"
    },
    "networkPolicy": {
      "description": "Network policy settings."
    },
    "nodeSelector": {
      "description": "Node labels for pod assignment\nRef: https://kubernetes.io/docs/user-guide/node-selection/"
    },
    "podAnnotations": {},
    "podDisruptionBudget": {
      "description": "PodDisruptionBudget settings\nref: https://kubernetes.io/docs/concepts/workloads/pods/disruptions/\nOne of maxUnavailable and minAvailable must be set to null."
    },
    "podLabels": {},
    "podSecurityContext": {
      "description": "Configure Kubernetes security context for pod\nRef: https://kubernetes.io/docs/tasks/configure-pod-container/security-context/"
    },
    "priorityClassName": {},
    "proxyVarsAsSecrets": {
      "description": "Whether to use secrets instead of environment values for setting up OAUTH2_PROXY variables"
    },
    "readinessProbe": {},
    "redis-ha": {
      "additionalProperties": {},
      "allOf": [
        {
          "if": {
            "allOf": [
              {
                "$ref": "#/$defs/constrains~1enabled+enabled=null"
              },
              {
                "type": "object"
              },
              {
                "$ref": "#/$defs/constrains~1sentinel.auth:t"
              },
              {
                "$ref": "#/$defs/constrains~1sentinel.existingSecret"
              },
              {
                "$ref": "#/$defs/constrains~1sentinel.existingSecret:t"
              }
            ]
          },
          "then": {
            "$ref": "#/$defs/when~1sentinel.auth!=null+sentinel.existingSecret!=null~1then~1fail"
          }
        },
        {
          "if": {
            "allOf": [
              {
                "$ref": "#/$defs/constrains~1enabled:t"
              },
              {
                "$ref": "#/$defs/constrains~1sentinel.auth:t"
              },
              {
                "$ref": "#/$defs/constrains~1sentinel.existingSecret"
              },
              {
                "$ref": "#/$defs/constrains~1sentinel.existingSecret:t"
              }
            ]
          },
          "then": {
            "$ref": "#/$defs/when~1sentinel.auth!=null+sentinel.existingSecret!=null~1then~1fail"
          }
        }
      ],
      "description": "Enables and configure the automatic deployment of the redis-ha subchart",
      "properties": {
        "enabled": {
          "description": "provision an instance of the redis-ha sub-chart\nRedis specific helm chart settings, please see:\nhttps://artifacthub.io/packages/helm/dandydev-charts/redis-ha#general-parameters\nRecommended:\nredisPassword: xxxxx\nreplicas: 1\nIMPORTANT: When using a single replica (replicas: 1), you MUST also configure\nmin-replicas-to-write to 0 to avoid \"NOREPLICAS Not enough good replicas to write\" errors.\nSee: https://stackoverflow.com/a/59737862\nredis:\nconfig:\nmin-replicas-to-write: 0\npersistentVolume:\nenabled: false\nIf you install Redis using this sub chart, make sure that the password of the sub chart matches the password\nyou set in sessionStorage.redis.password (see above).\nIf you want to use redis in sentinel mode see:\nhttps://artifacthub.io/packages/helm/dandydev-charts/redis-ha#redis-sentinel-parameters"
        },
        "global": {
          "description": "Globally shared configuration"
        },
        "sentinel": {
          "additionalProperties": {},
          "description": "Sentinel specific configuration options",
          "properties": {
            "auth": {
              "description": "Enables or disables sentinel AUTH (Requires `sentinel.password` to be set)"
            },
            "existingSecret": {
              "description": "An existing secret containing a key defined by `sentinel.authKey` that configures `requirepass`\nin the conf parameters (Requires `sentinel.auth: enabled`, cannot be used in conjunction with `.Values.sentinel.password`)\nSupports templates like \"{{ .Release.Name }}-sentinel-creds\""
            }
          }
        }
      }
    },
    "replicaCount": {},
    "resizePolicy": {
      "description": "Container resize policy for runtime resource updates\nRef: https://kubernetes.io/docs/tasks/configure-pod-container/resize-container-resources/\n- resourceName: cpu\nrestartPolicy: NotRequired\n- resourceName: memory\nrestartPolicy: RestartContainer"
    },
    "resources": {
      "description": "limits:\ncpu: 100m\nmemory: 300Mi\nrequests:\ncpu: 100m\nmemory: 300Mi"
    },
    "revisionHistoryLimit": {},
    "securityContext": {
      "description": "Configure Kubernetes security context for container\nRef: https://kubernetes.io/docs/tasks/configure-pod-container/security-context/"
    },
    "service": {},
    "serviceAccount": {
      "description": "Create or use ServiceAccount"
    },
    "sessionStorage": {
      "description": "Configure the session storage type, between cookie and redis"
    },
    "strategy": {},
    "tolerations": {
      "description": "Tolerations for pod assignment\nRef: https://kubernetes.io/docs/concepts/configuration/taint-and-toleration/"
    }
  },
  "type": "object"
}
