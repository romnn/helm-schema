{
  "$defs": {
    "constrains/fullnameOverride": {
      "not": {
        "$ref": "#/$defs/constrains~1fullnameOverride@2"
      }
    },
    "constrains/fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+1more": {
      "anyOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride+fullnameOverride:t+verticalPodAutoscaler.enabled:t"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t+nameOverride+nameOverride:t+verticalPodAutoscaler.enabled:t"
        }
      ]
    },
    "constrains/fullnameOverride+fullnameOverride:t+verticalPodAutoscaler.enabled:t": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride"
        },
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
        },
        {
          "$ref": "#/$defs/constrains~1verticalPodAutoscaler.enabled:t"
        }
      ]
    },
    "constrains/fullnameOverride:t": {
      "not": {
        "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
      }
    },
    "constrains/fullnameOverride:t+nameOverride+nameOverride:t+verticalPodAutoscaler.enabled:t": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1fullnameOverride:t"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride"
        },
        {
          "$ref": "#/$defs/constrains~1nameOverride:t"
        },
        {
          "$ref": "#/$defs/constrains~1verticalPodAutoscaler.enabled:t"
        }
      ]
    },
    "constrains/fullnameOverride:t@2": {
      "properties": {
        "fullnameOverride": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "fullnameOverride"
      ],
      "type": "object"
    },
    "constrains/fullnameOverride@2": {
      "properties": {
        "fullnameOverride": {
          "type": "string"
        }
      },
      "required": [
        "fullnameOverride"
      ],
      "type": "object"
    },
    "constrains/nameOverride": {
      "not": {
        "$ref": "#/$defs/constrains~1nameOverride@2"
      }
    },
    "constrains/nameOverride:t": {
      "properties": {
        "nameOverride": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "nameOverride"
      ],
      "type": "object"
    },
    "constrains/nameOverride@2": {
      "properties": {
        "nameOverride": {
          "type": "string"
        }
      },
      "required": [
        "nameOverride"
      ],
      "type": "object"
    },
    "constrains/verticalPodAutoscaler.enabled:t": {
      "properties": {
        "verticalPodAutoscaler": {
          "properties": {
            "enabled": {
              "$ref": "#/$defs/t"
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        }
      },
      "required": [
        "verticalPodAutoscaler"
      ],
      "type": "object"
    },
    "constrains/verticalPodAutoscaler.recommenders:t": {
      "properties": {
        "verticalPodAutoscaler": {
          "properties": {
            "recommenders": {
              "$ref": "#/$defs/t"
            }
          },
          "required": [
            "recommenders"
          ],
          "type": "object"
        }
      },
      "required": [
        "verticalPodAutoscaler"
      ],
      "type": "object"
    },
    "t": {
      "anyOf": [
        {
          "minProperties": 1,
          "type": "object"
        },
        {
          "not": {
            "const": 0
          },
          "type": "number"
        },
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "minItems": 1,
          "type": "array"
        },
        {
          "const": true
        }
      ]
    },
    "when/fullnameOverride/then/any/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1fullnameOverride@2"
      },
      "then": true
    },
    "when/fullnameOverride:t/then/fail/else/nameOverride:t+verticalPodAutoscaler.enabled:t": {
      "else": {
        "$ref": "#/$defs/when~1nameOverride:t~1then~1verticalPodAutoscaler.enabled:t~1else~1fail"
      },
      "if": {
        "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
      },
      "then": false
    },
    "when/fullnameOverride:t/then/fullnameOverride+verticalPodAutoscaler.enabled:t+1more/else/nameOverride+nameOverride:t": {
      "else": {
        "$ref": "#/$defs/when~1nameOverride:t~1then~1nameOverride+verticalPodAutoscaler.enabled:t+1more~1else~1any"
      },
      "if": {
        "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
      },
      "then": {
        "$ref": "#/$defs/when~1verticalPodAutoscaler.enabled:t~1then~1fullnameOverride+verticalPodAutoscaler.recommenders:t~1else~1fail"
      }
    },
    "when/fullnameOverride:t/then/verticalPodAutoscaler.enabled:t/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1fullnameOverride:t@2"
      },
      "then": {
        "$ref": "#/$defs/when~1verticalPodAutoscaler.enabled:t~1then~1any~1else~1fail"
      }
    },
    "when/nameOverride/then/any/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1nameOverride@2"
      },
      "then": true
    },
    "when/nameOverride:t/then/nameOverride+verticalPodAutoscaler.enabled:t+1more/else/any": {
      "else": {
        "$ref": "#/$defs/when~1verticalPodAutoscaler.enabled:t~1then~1verticalPodAutoscaler.recommenders:t~1else~1fail"
      },
      "if": {
        "$ref": "#/$defs/constrains~1nameOverride:t"
      },
      "then": {
        "$ref": "#/$defs/when~1verticalPodAutoscaler.enabled:t~1then~1nameOverride+verticalPodAutoscaler.recommenders:t~1else~1fail"
      }
    },
    "when/nameOverride:t/then/verticalPodAutoscaler.enabled:t/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1nameOverride:t"
      },
      "then": {
        "$ref": "#/$defs/when~1verticalPodAutoscaler.enabled:t~1then~1any~1else~1fail@2"
      }
    },
    "when/verticalPodAutoscaler.enabled:t/then/any/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1verticalPodAutoscaler.enabled:t"
      },
      "then": true
    },
    "when/verticalPodAutoscaler.enabled:t/then/any/else/fail@2": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1verticalPodAutoscaler.enabled:t"
      },
      "then": true
    },
    "when/verticalPodAutoscaler.enabled:t/then/fullnameOverride+verticalPodAutoscaler.recommenders:t/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1verticalPodAutoscaler.enabled:t"
      },
      "then": {
        "$ref": "#/$defs/when~1verticalPodAutoscaler.recommenders:t~1then~1fullnameOverride~1else~1fail"
      }
    },
    "when/verticalPodAutoscaler.enabled:t/then/nameOverride+verticalPodAutoscaler.recommenders:t/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1verticalPodAutoscaler.enabled:t"
      },
      "then": {
        "$ref": "#/$defs/when~1verticalPodAutoscaler.recommenders:t~1then~1nameOverride~1else~1fail"
      }
    },
    "when/verticalPodAutoscaler.enabled:t/then/verticalPodAutoscaler.recommenders:t/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1verticalPodAutoscaler.enabled:t"
      },
      "then": {
        "$ref": "#/$defs/when~1verticalPodAutoscaler.recommenders:t~1then~1any~1else~1fail"
      }
    },
    "when/verticalPodAutoscaler.recommenders:t/then/any/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1verticalPodAutoscaler.recommenders:t"
      },
      "then": true
    },
    "when/verticalPodAutoscaler.recommenders:t/then/fullnameOverride/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1verticalPodAutoscaler.recommenders:t"
      },
      "then": {
        "$ref": "#/$defs/when~1fullnameOverride~1then~1any~1else~1fail"
      }
    },
    "when/verticalPodAutoscaler.recommenders:t/then/nameOverride/else/fail": {
      "else": false,
      "if": {
        "$ref": "#/$defs/constrains~1verticalPodAutoscaler.recommenders:t"
      },
      "then": {
        "$ref": "#/$defs/when~1nameOverride~1then~1any~1else~1fail"
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "verticalPodAutoscaler": {
                "enum": [
                  null
                ]
              }
            },
            "required": [
              "verticalPodAutoscaler"
            ],
            "type": "object"
          },
          {
            "not": {
              "properties": {
                "verticalPodAutoscaler": {}
              },
              "required": [
                "verticalPodAutoscaler"
              ],
              "type": "object"
            }
          }
        ]
      },
      "then": false
    },
    {
      "if": {
        "$ref": "#/$defs/constrains~1fullnameOverride+fullnameOverride:t+nameOverride+nameOverride:t+1more"
      },
      "then": false
    },
    {
      "if": {
        "$ref": "#/$defs/when~1fullnameOverride:t~1then~1fullnameOverride+verticalPodAutoscaler.enabled:t+1more~1else~1nameOverride+nameOverride:t"
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "verticalPodAutoscaler": {
            "additionalProperties": {},
            "description": "--- Vertical Pod Autoscaler",
            "properties": {
              "recommenders": {
                "type": [
                  "array",
                  "integer",
                  "null",
                  "object"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "$ref": "#/$defs/when~1fullnameOverride:t~1then~1fail~1else~1nameOverride:t+verticalPodAutoscaler.enabled:t"
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "nameOverride": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "$ref": "#/$defs/when~1fullnameOverride:t~1then~1verticalPodAutoscaler.enabled:t~1else~1fail"
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "fullnameOverride": {
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "additionalPeers": {},
    "affinity": {},
    "automountServiceAccountToken": {},
    "baseURL": {
      "description": "Full external URL where alertmanager is reachable, used for backlinks."
    },
    "command": {},
    "config": {},
    "configAnnotations": {
      "description": "For example if you want to provide private data from a secret vault\nhttps://github.com/banzaicloud/bank-vaults/tree/main/charts/vault-secrets-webhook\nP.s.: Add option `configMapMutation: true` for vault-secrets-webhook\nvault.security.banzaicloud.io/vault-role: \"admin\"\nvault.security.banzaicloud.io/vault-addr: \"https://vault.vault.svc.cluster.local:8200\"\nvault.security.banzaicloud.io/vault-skip-verify: \"true\"\nvault.security.banzaicloud.io/vault-path: \"kubernetes\"\nExample for inject secret\nslack_api_url: '${vault:secret/data/slack-hook-alerts#URL}'"
    },
    "configmapReload": {
      "description": "Monitors ConfigMap changes and POSTs to a URL\nRef: https://github.com/prometheus-operator/prometheus-operator/tree/main/cmd/prometheus-config-reloader"
    },
    "containerPortName": {},
    "dnsConfig": {},
    "extraArgs": {},
    "extraContainers": {
      "description": "Additional containers to add to the stateful set. This will allow to setup sidecarContainers like a proxy to integrate\nalertmanager with an external tool like teams that has not direct integration."
    },
    "extraEnv": {
      "description": "Optionally specify extra environment variables to add to alertmanager container\n- name: FOO\nvalue: BAR"
    },
    "extraInitContainers": {
      "description": "Additional InitContainers to initialize the pod"
    },
    "extraPodConfigs": {
      "description": "--- Extra Pod Configs\ndnsPolicy: ClusterFirstWithHostNet\nhostNetwork: true"
    },
    "extraSecretMounts": {
      "description": "Additional Alertmanager Secret mounts\nDefines additional mounts with secrets. Secrets must be manually created in the namespace.\n- name: secret-files\nmountPath: /etc/secrets\nsubPath: \"\"\nsecretName: alertmanager-secret-files\nreadOnly: true"
    },
    "extraVolumeMounts": {
      "description": "Optionally specify extra list of additional volumeMounts\n- name: extras\nmountPath: /usr/share/extras\nreadOnly: true"
    },
    "extraVolumes": {
      "description": "Optionally specify extra list of additional volumes\n- name: extras\nemptyDir: {}"
    },
    "fullnameOverride": {},
    "global": {},
    "hostAliases": {
      "description": "nameservers:\n- 1.2.3.4\nsearches:\n- ns1.svc.cluster-domain.example\n- my.dns.search.suffix\noptions:\n- name: ndots\nvalue: \"2\"\n- name: edns0"
    },
    "hostUsers": {
      "description": "Running within a user namespace.\nKubernetes server must be at or later than version v1.25.\nKubernetes v1.25 through to v1.27 recognise UserNamespacesStatelessPodsSupport.\nKubernetes v1.28 through to v1.32 need to enable the UserNamespacesSupport feature gate."
    },
    "image": {},
    "imagePullSecrets": {},
    "ingress": {},
    "ingressPerReplica": {
      "description": "Configuration for creating an Ingress that will map to each Alertmanager replica service\nalertmanager.servicePerReplica must be enabled"
    },
    "livenessProbe": {},
    "minReadySeconds": {
      "description": "Minimum number of seconds for which a newly created pod should be ready without any of its container crashing for it to\nbe considered available. Defaults to 0 (pod will be considered available as soon as it is ready).\nThis is an alpha field from kubernetes 1.22 until 1.24 which requires enabling the StatefulSetMinReadySeconds\nfeature gate.\nRef: https://kubernetes.io/docs/concepts/workloads/controllers/statefulset/#minimum-ready-seconds"
    },
    "nameOverride": {},
    "namespaceOverride": {
      "description": "namespaceOverride overrides the namespace which the resources will be deployed in"
    },
    "nodeSelector": {},
    "persistence": {},
    "podAnnotations": {},
    "podAntiAffinity": {
      "description": "Pod anti-affinity can prevent the scheduler from placing Alertmanager replicas on the same node.\nThe default value \"soft\" means that the scheduler should *prefer* to not schedule two replica pods onto the same node but no guarantee is provided.\nThe value \"hard\" means that the scheduler is *required* to not schedule two replica pods onto the same node.\nThe value \"\" will disable pod anti-affinity so that no anti-affinity rules will be configured."
    },
    "podAntiAffinityTopologyKey": {
      "description": "If anti-affinity is enabled sets the topologyKey to use for anti-affinity.\nThis can be changed to, for example, failure-domain.beta.kubernetes.io/zone"
    },
    "podDisruptionBudget": {
      "description": "Ref: https://kubernetes.io/docs/tasks/run-application/configure-pdb/\nmaxUnavailable: 1\nminAvailable: 1"
    },
    "podLabels": {},
    "podSecurityContext": {},
    "priorityClassName": {
      "description": "Sets priorityClassName in alertmanager pod"
    },
    "readinessProbe": {},
    "replicaCount": {},
    "resources": {
      "description": "We usually recommend not to specify default resources and to leave this as a conscious\nchoice for the user. This also increases chances charts run on environments with little\nresources, such as Minikube. If you do want to specify resources, uncomment the following\nlines, adjust them as necessary, and remove the curly braces after 'resources:'.\nlimits:\ncpu: 100m\nmemory: 128Mi\nrequests:\ncpu: 10m\nmemory: 32Mi"
    },
    "revisionHistoryLimit": {
      "description": "Number of old history to retain to allow rollback\nDefault Kubernetes value is set to 10"
    },
    "route": {
      "description": "route (map) allows configuration of Gateway API HTTPRoute resources\nRequires Gateway API resources and a suitable controller installed within the cluster\nRef. https://gateway-api.sigs.k8s.io/guides/http-routing/"
    },
    "schedulerName": {
      "description": "Sets schedulerName in alertmanager pod"
    },
    "securityContext": {
      "description": "- ip: \"127.0.0.1\"\nhostnames:\n- \"foo.local\"\n- \"bar.local\"\n- ip: \"10.1.2.3\"\nhostnames:\n- \"foo.remote\"\n- \"bar.remote\""
    },
    "service": {},
    "serviceAccount": {},
    "serviceMonitor": {},
    "servicePerReplica": {
      "description": "Configuration for creating a separate Service for each statefulset Alertmanager replica"
    },
    "statefulSet": {},
    "templates": {
      "description": "alertmanager.tmpl: |-"
    },
    "testFramework": {},
    "tolerations": {},
    "topologySpreadConstraints": {
      "description": "Topology spread constraints rely on node labels to identify the topology domain(s) that each Node is in.\nRef: https://kubernetes.io/docs/concepts/workloads/pods/pod-topology-spread-constraints/\n- maxSkew: 1\ntopologyKey: failure-domain.beta.kubernetes.io/zone\nwhenUnsatisfiable: DoNotSchedule\nlabelSelector:\nmatchLabels:\napp.kubernetes.io/instance: alertmanager"
    },
    "verticalPodAutoscaler": {
      "additionalProperties": {},
      "description": "--- Vertical Pod Autoscaler",
      "properties": {
        "enabled": {
          "description": "Use VPA for alertmanager\nrecommenders:\n- name: 'alternative'\nupdatePolicy:\nupdateMode: \"Auto\"\nminReplicas: 1\nresourcePolicy:\ncontainerPolicies:\n- containerName: '*'\nminAllowed:\ncpu: 100m\nmemory: 128Mi\nmaxAllowed:\ncpu: 1\nmemory: 500Mi\ncontrolledResources: [\"cpu\", \"memory\"]"
        },
        "recommenders": {}
      },
      "type": "object"
    }
  },
  "type": "object"
}
