  "properties": {
    "affinity": {
      "description": "Affinity to use for the Velero deployment. Optional."
    },
    "annotations": {
      "description": "Annotations to add to the Velero deployment's. Optional.\nIf you are using reloader use the following annotation with your VELERO_SECRET_NAME\nsecret.reloader.stakater.com/reload: \"<VELERO_SECRET_NAME>\""
