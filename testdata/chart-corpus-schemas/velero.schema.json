    "backupsEnabled": {
      "description": "Whether to create backupstoragelocation crd, if false => do not create a default backup location"
    },
    "cleanUpCRDs": {
      "description": "This job is meant primarily for cleaning up CRDs on CI systems.\nUsing this on production systems, especially those that have multiple releases of Velero, will be destructive."
    },
    "configMaps": {
      "description": "Velero ConfigMaps.\nEg:\nconfigMaps:\nSee: https://velero.io/docs/v1.11/file-system-backup/\nfs-restore-action-config:\nlabels:\nvelero.io/plugin-config: \"\"\nvelero.io/pod-volume-restore: RestoreItemAction\ndata:\nimage: velero/velero:v1.17.1\ncpuRequest: 200m\nmemRequest: 128Mi\ncpuLimit: 200m\nmemLimit: 128Mi\nsecCtx: |\ncapabilities:\ndrop:\n- ALL\nadd: []\nallowPrivilegeEscalation: false\nreadOnlyRootFilesystem: true\nrunAsUser: 1001\nrunAsGroup: 999"
    },
    "configuration": {
      "description": "Parameters for the `default` BackupStorageLocation and VolumeSnapshotLocation,\nand additional server settings."
    },
    "containerSecurityContext": {
      "description": "Container Level Security Context for the 'velero' container of the Velero deployment. Optional.\nSee: https://kubernetes.io/docs/tasks/configure-pod-container/security-context/#set-the-security-context-for-a-container\nallowPrivilegeEscalation: false\ncapabilities:\ndrop: [\"ALL\"]\nadd: []\nreadOnlyRootFilesystem: true"
    },
    "credentials": {
      "description": "Info about the secret to be used by the Velero deployment, which\nshould contain credentials for the cloud provider IAM account you've\nset up for Velero."
    },
    "deployNodeAgent": {
      "description": "Whether to deploy the node-agent daemonset."
    },
    "dnsConfig": {
      "description": "DNS configuration to use for the Velero deployment. Optional."
