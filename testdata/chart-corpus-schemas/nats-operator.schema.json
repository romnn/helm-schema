          "description": "Nats version\nImage tags are listed here: https://hub.docker.com/_/nats?tab=tags",
          "type": "string"
        }
      },
      "type": "object"
    },
    "clusterScoped": {
      "description": "Operator scope\nNOTE: If true\n* Make sure that no other NATS operator is running in the cluster\n* The Release namespace must be \"nats-io\""
    },
    "global": {},
    "image": {},
    "livenessProbe": {
      "description": "Configure extra options for liveness and readiness probes\nref: https://kubernetes.io/docs/tasks/configure-pod-container/configure-liveness-readiness-probes/#configure-probes"
    },
    "podAnnotations": {
      "description": "Pod annotations\nref: https://kubernetes.io/docs/concepts/overview/working-with-objects/annotations/"
    },
