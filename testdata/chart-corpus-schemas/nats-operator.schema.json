                  "type": "string"
                }
              },
              "type": "object"
            },
            "tag": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "name": {},
        "namespace": {
          "description": "Choose namespace for cluster deployment if clusterScoped is set to true"
        },
        "resources": {
          "additionalProperties": {},
          "description": "limits:\ncpu: 500m\nmemory: 512Mi\nrequests:\ncpu: 100m\nmemory: 256Mi",
          "type": "object"
        },
        "size": {
          "description": "Cluster Size",
          "type": "integer"
        },
        "tls": {
