{
  "$defs": {
    "constrains/auth.enabled:t": {
      "properties": {
        "auth": {
          "properties": {
            "enabled": {
              "$ref": "#/$defs/t"
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        }
      },
      "required": [
        "auth"
      ],
      "type": "object"
    },
    "constrains/cluster+cluster.namespace": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1cluster.namespace"
        },
        {
          "$ref": "#/$defs/constrains~1cluster.namespace@3"
        }
      ]
    },
    "constrains/cluster+cluster.namespace@2": {
      "allOf": [
        {
          "$ref": "#/$defs/constrains~1cluster+cluster.namespace"
        },
        {
          "$ref": "#/$defs/constrains~1cluster.namespace@3"
        }
      ]
    },
    "constrains/cluster+cluster.namespace@3": {
      "anyOf": [
        {
          "$ref": "#/$defs/constrains~1cluster+cluster.namespace@2"
        },
        {
          "properties": {
            "cluster": {
              "properties": {
                "namespace": {
                  "type": "number"
                }
              },
              "required": [
                "namespace"
              ],
              "type": "object"
            }
          },
          "required": [
            "cluster"
          ],
          "type": "object"
        },
        {
          "properties": {
            "cluster": {
              "properties": {
                "namespace": {
                  "type": "boolean"
                }
              },
              "required": [
                "namespace"
              ],
              "type": "object"
            }
          },
          "required": [
            "cluster"
          ],
          "type": "object"
        }
      ]
    },
    "constrains/cluster.auth.enabled:t": {
      "properties": {
        "cluster": {
          "$ref": "#/$defs/constrains~1auth.enabled:t"
        }
      },
      "required": [
        "cluster"
      ],
      "type": "object"
    },
    "constrains/cluster.create:t": {
      "properties": {
        "cluster": {
          "$ref": "#/$defs/constrains~1create:t"
        }
      },
      "required": [
        "cluster"
      ],
      "type": "object"
    },
    "constrains/cluster.name": {
      "properties": {
        "cluster": {
          "properties": {
            "name": {
              "pattern": "^(?:(?:[\\x20])*[\\x30-\\x39\\x41-\\x5a\\x5f\\x61-\\x7a](?:[\\x20\\x2d-\\x39\\x41-\\x5a\\x5f\\x61-\\x7a])*)$",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        }
      },
      "required": [
        "cluster"
      ],
      "type": "object"
    },
    "constrains/cluster.namespace": {
      "not": {
        "properties": {
          "cluster": {
            "properties": {
              "namespace": {
                "pattern": "<$|<n$|<no $|<no v$|<no va$|<no val$|<no valu$|<no value$|<no value>|<no$|^ $|^ v$|^ va$|^ val$|^ valu$|^ value$|^ value>|^ value>$|^$|^<$|^<n$|^<no $|^<no v$|^<no va$|^<no val$|^<no valu$|^<no value$|^<no value>$|^<no$|^>|^>$|^a$|^al$|^alu$|^alue$|^alue>|^alue>$|^e$|^e>|^e>$|^l$|^lu$|^lue$|^lue>|^lue>$|^n$|^no $|^no v$|^no va$|^no val$|^no valu$|^no value$|^no value>|^no value>$|^no$|^o $|^o v$|^o va$|^o val$|^o valu$|^o value$|^o value>|^o value>$|^o$|^u$|^ue$|^ue>|^ue>$|^v$|^va$|^val$|^valu$|^value$|^value>|^value>$",
                "type": "string"
              }
            },
            "required": [
              "namespace"
            ],
            "type": "object"
          }
        },
        "required": [
          "cluster"
        ],
        "type": "object"
      }
    },
    "constrains/cluster.namespace@2": {
      "properties": {
        "cluster": {
          "properties": {
            "namespace": {
              "type": "array"
            }
          },
          "required": [
            "namespace"
          ],
          "type": "object"
        }
      },
      "required": [
        "cluster"
      ],
      "type": "object"
    },
    "constrains/cluster.namespace@3": {
      "properties": {
        "cluster": {
          "properties": {
            "namespace": {
              "type": "string"
            }
          },
          "required": [
            "namespace"
          ],
          "type": "object"
        }
      },
      "required": [
        "cluster"
      ],
      "type": "object"
    },
    "constrains/clusterScoped:t": {
      "properties": {
        "clusterScoped": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "clusterScoped"
      ],
      "type": "object"
    },
    "constrains/create:t": {
      "properties": {
        "create": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "create"
      ],
      "type": "object"
    },
    "constrains/rbacEnabled:t": {
      "properties": {
        "rbacEnabled": {
          "$ref": "#/$defs/t"
        }
      },
      "required": [
        "rbacEnabled"
      ],
      "type": "object"
    },
    "t": {
      "anyOf": [
        {
          "minProperties": 1,
          "type": "object"
        },
        {
          "not": {
            "const": 0
          },
          "type": "number"
        },
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "minItems": 1,
          "type": "array"
        },
        {
          "const": true
        }
      ]
    },
    "values/anyOf/null,boolean,number+string": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number"
          ]
        },
        {
          "$ref": "#/$defs/values~1string@3"
        }
      ]
    },
    "values/null;namespace-defines-the-space": {
      "description": "Namespace defines the space within which each name must be unique. An empty namespace is equivalent to the \"default\" namespace, but \"default\" is the canonical representation. Not all objects are required to be scoped to a namespace - the value of this field for those objects will be empty.\n\nMust be a DNS_LABEL. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/namespaces",
      "type": "null"
    },
    "values/object": {
      "additionalProperties": {
        "anyOf": [
          {
            "maxItems": 0,
            "type": "array"
          },
          {
            "type": "integer"
          },
          {
            "$ref": "#/$defs/values~1string"
          },
          {
            "type": "number"
          },
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "maxProperties": 0,
            "type": "object"
          }
        ]
      },
      "propertyNames": {
        "$ref": "#/$defs/values~1string"
      },
      "type": "object"
    },
    "values/string": {
      "allOf": [
        {
          "not": {
            "pattern": "[ \\t]#"
          }
        },
        {
          "not": {
            "pattern": ":[ \\t]|:$"
          }
        },
        {
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ],
      "type": "string"
    },
    "values/string;namespace-defines-the-space": {
      "allOf": [
        {
          "not": {
            "pattern": "^[-?:]([ \\t]|$)"
          }
        },
        {
          "not": {
            "pattern": "^(([+-]_*)?(0|[1-9][0-9_]{0,17}|0[xX][0-9a-fA-F]{1,15}|0[bB][01]{1,62}|0[oO][0-7]{1,20}|0[0-7]{1,20})|[+-]_*0[0-7]{0,8}[89][0-9]{0,8})$"
          }
        },
        {
          "not": {
            "pattern": "^[!&*#{}\\[\\],|>@`%]"
          }
        },
        {
          "not": {
            "pattern": "[ \\t]#"
          }
        },
        {
          "not": {
            "pattern": "^([+-]?\\.(inf|Inf|INF)|\\.(nan|NaN|NAN))$"
          }
        },
        {
          "not": {
            "pattern": "^(true|True|TRUE|false|False|FALSE|yes|Yes|YES|no|No|NO|on|On|ON|off|Off|OFF|y|Y|n|N)$"
          }
        },
        {
          "not": {
            "pattern": "^(|~|null|Null|NULL)$"
          }
        },
        {
          "not": {
            "pattern": ":[ \\t]|:$"
          }
        },
        {
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        {
          "not": {
            "pattern": "^([0-9][0-9_]{0,50}(\\.[0-9_]{0,50})?([eE][+-]?[0-9]{1,2})?|[+-]_*[0-9][0-9_]{0,50}(\\.[0-9_]{0,50})?([eE][+-]?[0-9]{1,2})?|[+-]_*\\._*[0-9][0-9_]{0,50}([eE][+-]?[0-9]{1,2})?|\\.[0-9]{1,50}([eE][+-]?[0-9]{1,2})?)$"
          }
        }
      ],
      "description": "Namespace defines the space within which each name must be unique. An empty namespace is equivalent to the \"default\" namespace, but \"default\" is the canonical representation. Not all objects are required to be scoped to a namespace - the value of this field for those objects will be empty.\n\nMust be a DNS_LABEL. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/namespaces",
      "type": "string"
    },
    "values/string;pattern-null-null-null": {
      "pattern": "^(~|null|Null|NULL)([ \\t]+#.*)?$",
      "type": "string"
    },
    "values/string@2": {
      "allOf": [
        {
          "not": {
            "pattern": "^(null|Null|NULL)[ \\t]+#"
          }
        },
        {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.+/\\-]*[ \\t]+#"
        },
        {
          "not": {
            "pattern": "^(true|True|TRUE|false|False|FALSE|yes|Yes|YES|no|No|NO|on|On|ON|off|Off|OFF|y|Y|n|N)[ \\t]+#"
          }
        }
      ],
      "type": "string"
    },
    "values/string@3": {
      "not": {
        "pattern": "[^A-Za-z0-9_./+-]"
      },
      "type": "string"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "allOf": [
          {
            "$ref": "#/$defs/constrains~1rbacEnabled:t"
          },
          {
            "$ref": "#/$defs/constrains~1cluster+cluster.namespace@3"
          },
          {
            "$ref": "#/$defs/constrains~1clusterScoped:t"
          }
        ]
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "cluster": {
            "additionalProperties": {},
            "properties": {
              "namespace": {
                "anyOf": [
                  {
                    "not": {
                      "pattern": "^[A-Za-z]+\\n[A-Za-z]+$"
                    },
                    "pattern": "[\\r\\n]",
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/values~1null;namespace-defines-the-space"
                  },
                  {
                    "$ref": "#/$defs/values~1string@2"
                  },
                  {
                    "not": {
                      "$ref": "#/$defs/t"
                    }
                  },
                  {
                    "pattern": "^&[A-Za-z0-9_-]+[ \\t]*(#.*)?$",
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/values~1object"
                  },
                  {
                    "pattern": "^[ \\t]*(#.*)?$",
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/values~1string;pattern-null-null-null"
                  },
                  {
                    "$ref": "#/$defs/values~1string;namespace-defines-the-space"
                  }
                ],
                "description": "Choose namespace for cluster deployment if clusterScoped is set to true"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "properties": {
                "cluster": {}
              },
              "required": [
                "cluster"
              ],
              "type": "object"
            }
          },
          {
            "properties": {
              "cluster": {
                "enum": [
                  null
                ]
              }
            },
            "required": [
              "cluster"
            ],
            "type": "object"
          }
        ]
      },
      "then": false
    },
    {
      "if": {
        "$ref": "#/$defs/constrains~1cluster.create:t"
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "cluster": {
            "additionalProperties": {},
            "properties": {
              "auth": {
                "description": "Client Authentication\nref: https://github.com/nats-io/gnatsd#authentication\nnote: token not supported only user/password will work with this chart version",
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "$ref": "#/$defs/constrains~1rbacEnabled:t"
          },
          {
            "properties": {
              "cluster": {
                "properties": {
                  "namespace": {
                    "type": "object"
                  }
                },
                "required": [
                  "namespace"
                ],
                "type": "object"
              }
            },
            "required": [
              "cluster"
            ],
            "type": "object"
          },
          {
            "$ref": "#/$defs/constrains~1clusterScoped:t"
          }
        ]
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "cluster": {
            "additionalProperties": {},
            "properties": {
              "namespace": {
                "anyOf": [
                  {
                    "not": {
                      "$ref": "#/$defs/t"
                    }
                  },
                  {
                    "not": {
                      "additionalProperties": {
                        "not": {
                          "pattern": "[^A-Za-z0-9_.$/+: \t-]"
                        },
                        "pattern": "^[A-Za-z0-9_.$/+-]+:[ \t]+[A-Za-z0-9_.$/+-]+$",
                        "type": "string"
                      },
                      "maxProperties": 1,
                      "minProperties": 1,
                      "propertyNames": {
                        "minLength": 1,
                        "not": {
                          "pattern": "[^A-Za-z0-9_.$/+-]"
                        },
                        "type": "string"
                      },
                      "type": "object"
                    }
                  }
                ],
                "description": "Choose namespace for cluster deployment if clusterScoped is set to true"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "$ref": "#/$defs/constrains~1cluster.name"
          },
          {
            "$ref": "#/$defs/constrains~1cluster.create:t"
          },
          {
            "$ref": "#/$defs/constrains~1cluster+cluster.namespace@3"
          },
          {
            "$ref": "#/$defs/constrains~1clusterScoped:t"
          },
          {
            "$ref": "#/$defs/constrains~1cluster.auth.enabled:t"
          }
        ]
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "cluster": {
            "additionalProperties": {},
            "properties": {
              "namespace": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/values~1null;namespace-defines-the-space"
                  },
                  {
                    "$ref": "#/$defs/values~1string@2"
                  },
                  {
                    "not": {
                      "$ref": "#/$defs/t"
                    }
                  },
                  {
                    "pattern": "^&[A-Za-z0-9_-]+[ \\t]*(#.*)?$",
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/values~1object"
                  },
                  {
                    "pattern": "^[ \\t]*(#.*)?$",
                    "type": "string"
                  },
                  {
                    "pattern": "[\\r\\n]",
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/values~1string;pattern-null-null-null"
                  },
                  {
                    "$ref": "#/$defs/values~1string;namespace-defines-the-space"
                  }
                ],
                "description": "Choose namespace for cluster deployment if clusterScoped is set to true"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "allOf": [
              {
                "$ref": "#/$defs/constrains~1cluster.name"
              },
              {
                "$ref": "#/$defs/constrains~1cluster.create:t"
              },
              {
                "$ref": "#/$defs/constrains~1cluster.namespace@2"
              },
              {
                "$ref": "#/$defs/constrains~1clusterScoped:t"
              },
              {
                "$ref": "#/$defs/constrains~1cluster.auth.enabled:t"
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/$defs/constrains~1rbacEnabled:t"
              },
              {
                "$ref": "#/$defs/constrains~1cluster.namespace@2"
              },
              {
                "$ref": "#/$defs/constrains~1clusterScoped:t"
              }
            ]
          }
        ]
      },
      "then": {
        "additionalProperties": {},
        "properties": {
          "cluster": {
            "additionalProperties": {},
            "properties": {
              "namespace": {
                "anyOf": [
                  {
                    "not": {
                      "$ref": "#/$defs/t"
                    }
                  },
                  {
                    "not": {
                      "items": {
                        "anyOf": [
                          {
                            "additionalProperties": {
                              "$ref": "#/$defs/values~1anyOf~1null,boolean,number+string"
                            },
                            "propertyNames": {
                              "$ref": "#/$defs/values~1string@3"
                            },
                            "type": "object"
                          },
                          {
                            "type": [
                              "null",
                              "boolean",
                              "number"
                            ]
                          },
                          {
                            "items": {
                              "$ref": "#/$defs/values~1anyOf~1null,boolean,number+string"
                            },
                            "type": "array"
                          },
                          {
                            "$ref": "#/$defs/values~1string@3"
                          }
                        ]
                      },
                      "type": "array"
                    }
                  }
                ],
                "description": "Choose namespace for cluster deployment if clusterScoped is set to true"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "antiAffinity": {
      "description": "Pods anti-affinity\nref: https://kubernetes.io/docs/concepts/configuration/assign-pod-node/#affinity-and-anti-affinity\nPossible values: soft, hard"
    },
    "cluster": {
      "additionalProperties": {},
      "allOf": [
        {
          "if": {
            "allOf": [
              {
                "$ref": "#/$defs/constrains~1create:t"
              },
              {
                "$ref": "#/$defs/constrains~1auth.enabled:t"
              },
              {
                "properties": {
                  "name": {
                    "anyOf": [
                      {
                        "maxItems": 0,
                        "type": "array"
                      }
                    ]
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            ]
          },
          "then": false
        },
        {
          "if": {
            "allOf": [
              {
                "$ref": "#/$defs/constrains~1create:t"
              },
              {
                "anyOf": [
                  {
                    "not": {
                      "properties": {
                        "auth": {}
                      },
                      "required": [
                        "auth"
                      ],
                      "type": "object"
                    }
                  },
                  {
                    "properties": {
                      "auth": {
                        "enum": [
                          null
                        ]
                      }
                    },
                    "required": [
                      "auth"
                    ],
                    "type": "object"
                  }
                ]
              }
            ]
          },
          "then": false
        }
      ],
      "properties": {
        "annotations": {
          "additionalProperties": {},
          "description": "Optional custom annotations to add to Pods in the cluster",
          "type": "object"
        },
        "auth": {
          "additionalProperties": {},
          "description": "Client Authentication\nref: https://github.com/nats-io/gnatsd#authentication\nnote: token not supported only user/password will work with this chart version",
          "properties": {
            "enabled": {}
          }
        },
        "configReload": {
          "additionalProperties": {},
