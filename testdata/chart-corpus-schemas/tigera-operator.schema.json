      "description": "imagePullSecrets is a special helm field which, when specified, creates a secret\ncontaining the pull secret which is used to pull all images deployed by this helm chart and the resulting operator.\nthis field is a map where the key is the desired secret name and the value is the contents of the imagePullSecret.\nExample: --set-file imagePullSecrets.gcr=./pull-secret.json"
    },
    "installation": {
      "additionalProperties": {},
      "description": "Configures general installation parameters for Calico. Schema is based\non the operator.tigera.io/Installation API documented\nhere: https://docs.tigera.io/calico/latest/reference/installation/api#installationspec",
      "properties": {
        "imagePullSecrets": {
          "description": "imagePullSecrets are configured on all images deployed by the tigera-operator.\nsecrets specified here must exist in the tigera-operator namespace; they won't be created by the operator or helm.\nimagePullSecrets are a slice of LocalObjectReferences, which is the same format they appear as on deployments.\nExample: --set installation.imagePullSecrets[0].name=my-existing-secret"
        },
        "kubernetesProvider": {
          "description": "Valid options: EKS, GKE, AKS, RKE2, OpenShift, DockerEnterprise, TKG, Kind.\nIf empty the operator will attempt to automatically determine the current provider."
        }
      }
    },
    "kubernetesServiceEndpoint": {
      "description": "Optionally configure the host and port used to access the Kubernetes API server."
    },
    "manageCRDs": {
