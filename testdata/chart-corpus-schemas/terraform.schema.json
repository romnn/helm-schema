      "additionalProperties": {},
      "description": "syncWorkspace will run the workspace sync process to sync K8S Workspaces with\nTerraform Cloud workspaces.\nThis process will deploy a Workspace Custom Resource Definition and\nTerraform Cloud Workspace Operator to the Kubernetes cluster. It requires\na Kubernetes secret for Terraform Cloud access and sensitive variables.",
      "properties": {
        "enabled": {
          "description": "True if you want to enable the workspace sync. Set to \"-\" to inherit from\nglobal.enabled."
