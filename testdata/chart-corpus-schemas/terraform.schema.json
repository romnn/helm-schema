    "syncWorkspace": {
      "additionalProperties": {},
      "description": "syncWorkspace will run the workspace sync process to sync K8S Workspaces with\nTerraform Cloud workspaces.\nThis process will deploy a Workspace Custom Resource Definition and\nTerraform Cloud Workspace Operator to the Kubernetes cluster. It requires\na Kubernetes secret for Terraform Cloud access and sensitive variables.",
      "properties": {
        "enabled": {
          "description": "True if you want to enable the workspace sync. Set to \"-\" to inherit from\nglobal.enabled."
        },
        "image": {},
        "imagePullPolicy": {},
        "insecure": {
          "description": "If true it disables certificate validation for all outbound HTTPS connections\nthe operator has to do. It can be used when connecting to TFE instances with\nself-signed certificates"
        },
        "k8WatchNamespace": {
          "description": "k8WatchNamespace is the Kubernetes namespace to watch for workspace\nchanges and sync to Terraform Cloud. If this is not set then it will default\nto the release namespace"
        },
        "logLevel": {},
        "sensitiveVariables": {
          "additionalProperties": {},
